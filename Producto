package tienda_de_musica;

public class Producto {
    private String codigo;
    private String nombre;
    private double precio;
    private int cantidadDisponible;

    public Producto(String codigo, String nombre, double precio, int cantidadDisponible) {
        this.codigo = codigo;
        this.nombre = nombre;

        if (precio > 0) {
            this.precio = precio;
        } else {
            this.precio = 1;
        }

        if (cantidadDisponible >= 0) {
            this.cantidadDisponible = cantidadDisponible;
        } else {
            this.cantidadDisponible = 0;
        }
    }

    public String getCodigo() {
        return codigo;
    }

    public String getNombre() {
        return nombre;
    }

    public double getPrecio() {
        return precio;
    }

    public int getCantidadDisponible() {
        return cantidadDisponible;
    }

    public void modificarPrecio(double nuevoPrecio) {
        if (nuevoPrecio > 0) {
            precio = nuevoPrecio;
        }
    }

    public void modificarInventario(int nuevaCantidad) {
        if (nuevaCantidad >= 0) {
            cantidadDisponible = nuevaCantidad;
        }
    }

    public void reducirInventario(int cantidad) {
        if (cantidad > 0 && cantidad <= cantidadDisponible) {
            cantidadDisponible -= cantidad;
        }
    }
}
